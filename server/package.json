{
  "name": "quiz-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for realtime quiz app (Express + Socket.IO + Prisma/SQLite)",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:ensure-db": "node prisma/ensureSqliteDatabase.js",
    "prisma:deploy": "npm run prisma:ensure-db && prisma migrate deploy",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.3.0",
    "nanoid": "6.0.1",
    "prisma": "6.19.3",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "nodemon": "3.1.14"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "deepmerge-ts": "8.0.2",
    "socket.io-parser": "4.2.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
