# Copy to .env. Generate independent production secrets with `openssl rand -hex 32`.
NODE_ENV="development"
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="local-development-access-secret-change-before-deploying"
JWT_REFRESH_SECRET="local-development-refresh-secret-change-before-deploying"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
TRUST_PROXY="false"
MAX_PARTICIPANTS_PER_ROOM=200
SHUTDOWN_TIMEOUT_MS=10000
